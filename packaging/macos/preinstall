#!/bin/bash
set -euo pipefail
# Fail before Installer replaces the application payload.
user="$(/usr/bin/stat -f '%Su' /dev/console)"
if [[ "$user" == "root" || "$user" == "loginwindow" || "$user" == "_mbsetupuser" ]]; then
    echo '请登录桌面用户后重新安装。' >&2
    exit 1
fi
python=""
for candidate in /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3; do
    if [[ "$candidate" == /usr/bin/python3 ]] && ! /usr/bin/xcode-select -p >/dev/null 2>&1; then
        continue
    fi
    if [[ -x "$candidate" ]] && /usr/bin/sudo -H -u "$user" "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 9))' 2>/dev/null; then
        python="$candidate"
        break
    fi
done
if [[ -z "$python" ]]; then
    echo '需要 Python 3.9 或更高版本。请先安装 Python，再运行此安装包。' >&2
    exit 1
fi
/usr/bin/sudo -H -u "$user" "$python" -B - --check < "$(dirname "$0")/deploy.py"
# Migrate the old user-visible bundle name before the new payload is unpacked.
# The project, bundle identifier and executable keep their existing names.
legacy='/Applications/workbuddy-cua.app'
current='/Applications/Workbuddy CUA.app'
if [[ -L "$legacy" || -L "$current" ]]; then
    echo '应用程序路径不能是符号链接。' >&2
    exit 1
fi
if [[ -e "$legacy" && -e "$current" ]]; then
    echo '同时发现新旧应用目录；请先移除旧的 workbuddy-cua.app。' >&2
    exit 1
fi
if [[ -e "$legacy" ]]; then
    identifier="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$legacy/Contents/Info.plist")"
    if [[ "$identifier" != 'com.workbuddy.cua.menubar' ]] || ! /usr/bin/codesign --verify --strict -R \
        '=anchor apple generic and identifier "com.workbuddy.cua.menubar" and certificate leaf[subject.OU] = "62RNP54C47"' "$legacy"; then
        echo '旧应用签名或标识无法验证；未移动应用目录。' >&2
        exit 1
    fi
    /bin/mv "$legacy" "$current"
fi
