#!/bin/bash
set -euo pipefail
# Fail before Installer replaces the application payload.
user="$(/usr/bin/stat -f '%Su' /dev/console)"
if [[ "$user" == "root" || "$user" == "loginwindow" || "$user" == "_mbsetupuser" ]]; then
    echo '请登录桌面用户后重新安装。' >&2
    exit 1
fi
python=""
for candidate in /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3; do
    if [[ "$candidate" == /usr/bin/python3 ]] && ! /usr/bin/xcode-select -p >/dev/null 2>&1; then
        continue
    fi
    if [[ -x "$candidate" ]] && /usr/bin/sudo -H -u "$user" "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 9))' 2>/dev/null; then
        python="$candidate"
        break
    fi
done
if [[ -z "$python" ]]; then
    echo '需要 Python 3.9 或更高版本。请先安装 Python，再运行此安装包。' >&2
    exit 1
fi
# Installer's private Scripts directory may not be traversable by the desktop
# user. Stage read-only, root-owned preflight code; never run their Python as root.
preflight="$(/usr/bin/mktemp -d /private/tmp/quietbridge-preflight.XXXXXX)"
prepared=false
complete=false
version=''
build=''
finish_preinstall() {
    result=$?
    trap - EXIT
    if [[ "$prepared" == true && "$complete" != true ]]; then
        if ! /usr/bin/sudo -H -u "$user" "$python" -B "$preflight/deploy.py" --abort-install \
                --package-version "$version" --package-build "$build"; then
            echo '应用恢复未完成；请运行“恢复安装.command”。' >&2
        fi
    fi
    /bin/rm -rf "$preflight"
    exit "$result"
}
trap finish_preinstall EXIT
version="$(/usr/libexec/PlistBuddy -c 'Print :version' "$(dirname "$0")/upgrade.plist")"
build="$(/usr/libexec/PlistBuddy -c 'Print :build' "$(dirname "$0")/upgrade.plist")"
/bin/cp "$(dirname "$0")/deploy.py" "$(dirname "$0")/compatibility.py" "$preflight/"
/bin/cp -R "$(dirname "$0")/adapters" "$preflight/adapters"
/bin/chmod -R a+rX "$preflight"
/usr/bin/sudo -H -u "$user" "$python" -B "$preflight/deploy.py" --check
# Only signed copies of our old/new identity may occupy the fixed install path.
verify_existing_app() {
    local identifier requirement
    identifier="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$1/Contents/Info.plist")"
    case "$identifier" in
        com.quietbridge.app)
            requirement='=anchor apple generic and identifier "com.quietbridge.app" and certificate leaf[subject.OU] = "62RNP54C47"' ;;
        com.workbuddy.cua.menubar)
            requirement='=anchor apple generic and identifier "com.workbuddy.cua.menubar" and certificate leaf[subject.OU] = "62RNP54C47"' ;;
        *) echo '现有应用标识无法识别；未替换应用。' >&2; return 1 ;;
    esac
    /usr/bin/codesign --verify --strict -R "$requirement" "$1"
}
current='/Applications/QuietBridge.app'
legacy=''
for candidate in '/Applications/Workbuddy CUA.app' '/Applications/workbuddy-cua.app'; do
    if [[ -L "$candidate" || -L "$current" ]]; then
        echo '应用程序路径不能是符号链接。' >&2
        exit 1
    fi
    if [[ -e "$candidate" ]]; then
        if [[ -n "$legacy" || -e "$current" ]]; then
            echo '发现多个 QuietBridge 新旧应用副本；请保留一个已验证副本后重试。' >&2
            exit 1
        fi
        legacy="$candidate"
    fi
done
if [[ -n "$legacy" ]]; then
    if ! verify_existing_app "$legacy"; then
        echo '旧应用签名或标识无法验证；未移动应用目录。' >&2
        exit 1
    fi
elif [[ -e "$current" ]]; then
    verify_existing_app "$current"
fi
# Stop only after every read-only preflight/signature check, before renaming or
# allowing PackageKit to replace any payload. Persist the original running state
# for postinstall; it must not mistake this deliberate stop for a stopped app.
/usr/bin/sudo -H -u "$user" "$python" -B "$preflight/deploy.py" --prepare-install \
    --package-version "$version" --package-build "$build"
prepared=true
if [[ -n "$legacy" ]]; then
    /bin/mv "$legacy" "$current"
fi
complete=true
