{
  "manifest_version": 3,
  "name": "WorkbuddyExtension",
  "version": "0.2.4",
  "minimum_chrome_version": "106",
  "description": "一次授权普通 HTTP/HTTPS，由可信原生端内部分配任务标签的只读状态桥。",
  "key": "",
  "permissions": [
    "webNavigation",
    "storage",
    "scripting",
    "nativeMessaging",
    "alarms"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
