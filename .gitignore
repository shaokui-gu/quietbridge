# 构建产物与临时目录
.build/
.build-legacy/
build/
build-deny-only/
ModuleCache/
__pycache__/
apps/macos/tmp/
*.pyc
*.pcm
*.o
*.swiftmodule
*.dSYM/

# 编译出的可执行文件与历史快照
quietbridge-native
quietbridge-native.*
workbuddy-cua-native
workbuddy-cua-native.*
dsh-cua-native
dsh-cua-native.*
*.backup
*.backup-*
*.pre-*

# 应用包与签名材料（含开发者证书链信息）
*.app/
*.provisionprofile
*.mobileprovision
*.p12
*.cer

# 测试证据与截图：体积大，且包含本机画面与路径
verify-2/
output/
services/mcp/shots/
*.log

# 运行时配置
.quietbridge-config/

# 本机记忆与编辑器
.workbuddy/
.DS_Store

# 本机构建产物（安装包与打包中间目录）
dist/

# Toolchain caches and local browser task state
.caches/
quietbridge-config/
cua-helper-config/
.cua-config/

# Generated by the browser host installer
extensions/chromium/native-host-config.json
extensions/chromium/native-host-launcher.sh
