{
  "manifest_version": 3,
  "name": "QuietBridge Browser",
  "version": "0.4.14",
  "minimum_chrome_version": "106",
  "description": "固定任务标签的后台浏览器控制：CDP 输入、文档绑定与后台弹窗；不回退桌面键鼠。",
  "key": "",
  "permissions": [
    "webNavigation",
    "storage",
    "scripting",
    "nativeMessaging",
    "alarms",
    "debugger"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
